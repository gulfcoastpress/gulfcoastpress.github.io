    {
      "id": "c7549f0f-42a3-416f-b594-5503ef7bee54",
      "name": "Score Lead Urgency",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        330,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:\"gpt-4o-mini\",messages:[{role:\"user\",content:\"Score this inbound lead for a local \"+$json.trade+\" business as HOT, WARM or COLD. HOT means urgent: water, gas, no heat or AC, roof open to weather. Reply with ONE word only. Lead: \"+JSON.stringify($json.body)}]}) }}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE",
          "name": "OpenAI account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "869d40c8-7dde-46f8-b89f-9e99569c8fbd",
      "name": "Build CRM Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        100
      ],
      "parameters": {
        "jsCode": "return $input.all().map((it,i)=>{const b=$(\"Receive Form Lead\").all()[i].json.body;const s=(it.json.choices?.[0]?.message?.content||\"COLD\").trim().toUpperCase().split(/\\W/)[0];return {json:{id:Date.now().toString()+i,date:new Date().toISOString(),name:b.name,email:b.email,phone:b.phone,service:b.service,source:\"webform\",score:s,status:\"new\",notes:b.message}}});"
      }
    },
